# Keep the build context small and never bake secrets or local build output into
# an image. Dependencies and build artifacts are recreated inside the Dockerfiles.

# dependencies (reinstalled with `npm ci`)
node_modules
**/node_modules

# build output (rebuilt in the image)
dist
**/dist
.next
**/.next
out
**/out
*.tsbuildinfo
**/*.tsbuildinfo

# secrets and local env — must never enter an image
.env
.env.*
!.env.example

# version control / CI
.git
.gitignore
.github

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# test / coverage / caches
coverage
**/coverage
.turbo

# docker / docs (not needed at build or run time)
Dockerfile
**/Dockerfile
docker-compose.yml
.dockerignore

# os / editor
.DS_Store
.idea
.vscode
*.swp
