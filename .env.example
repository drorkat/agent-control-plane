# --- Database ---
POSTGRES_USER=acp
POSTGRES_PASSWORD=acp_dev_password
POSTGRES_DB=acp
DATABASE_URL=postgresql://acp:acp_dev_password@localhost:5432/acp?schema=public

# --- API ---
API_PORT=4000
# 32+ char secret for signing sessions (CHANGE THIS in production!)
AUTH_SECRET=change-me-in-production-please-use-32-chars-min
# 32+ char secret used to encrypt stored provider API keys at rest (CHANGE THIS!)
ENCRYPTION_KEY=change-me-a-long-random-encryption-secret-min-32-chars

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- AI providers (bring your own key) ---
# Only the providers you actually use are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
