# --- Database ---
POSTGRES_USER=acp
POSTGRES_PASSWORD=acp_dev_password
POSTGRES_DB=acp
DATABASE_URL=postgresql://acp:acp_dev_password@localhost:5432/acp?schema=public

# --- API ---
API_PORT=4000
# REQUIRED. Both secrets below must be set to real, unique, random values of at
# least 32 characters. The API refuses to boot (assertSecureConfig) if either is
# missing, too short, or left as one of these known placeholders — this is
# deliberate, so a deployment can never run with a forgeable session token or a
# default at-rest key. Generate each with:  openssl rand -hex 32
#
# AUTH_SECRET signs the session JWT. Changing it invalidates all sessions.
AUTH_SECRET=change-me-in-production-please-use-32-chars-min
# ENCRYPTION_KEY derives the AES-256-GCM key that encrypts stored provider API
# keys and GitHub tokens at rest. To ROTATE it safely: set the new value here,
# set ENCRYPTION_KEY_OLD to the previous value (decryption falls back to it so
# nothing breaks), redeploy, run `npm run reencrypt-secrets -w @acp/api` to
# migrate every stored secret to the new key, then remove ENCRYPTION_KEY_OLD.
ENCRYPTION_KEY=change-me-a-long-random-encryption-secret-min-32-chars
# Only set during a key rotation (see above); leave empty otherwise.
ENCRYPTION_KEY_OLD=

# Session cookie flags. In production the cookie is always marked Secure; set
# COOKIE_SECURE=1 to force it on elsewhere (e.g. behind an HTTPS proxy in
# staging). Leave unset for local http dev.
COOKIE_SECURE=0

# Structured-log level (pino): trace|debug|info|warn|error|fatal. Logs are JSON
# with a per-request id. Prometheus metrics are exposed at GET /api/metrics
# (scrape from a trusted network / behind your ingress).
LOG_LEVEL=info

# --- Distributed tracing (optional, OpenTelemetry) ---
# Off by default (zero overhead). Set OTEL_EXPORTER_OTLP_ENDPOINT to export spans
# to a collector (e.g. http://otel-collector:4318), or OTEL_TRACING=1 to print
# spans to stdout for local debugging. When active, log lines carry the traceId
# so logs and traces correlate.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limiting (optional shared store) ---
# The API rate-limits requests in-memory per instance by default. To share one
# limit across multiple API replicas, point this at a Redis. Leave empty for the
# single-instance default. With docker compose: `docker compose --profile redis up`
# and set REDIS_URL=redis://redis:6379.
REDIS_URL=
# Escape hatch for tests and local load-testing only: set to 1 to disable the
# rate limiter entirely. Leave UNSET in production so the limits stay enforced.
# THROTTLE_DISABLED=1

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cross-origin allowlist for the API. The web app normally talks to the API
# same-origin (Next.js rewrites /api/* to the API), so this can stay unset and
# CORS is off. Only set it — as a comma-separated list of exact origins — when
# the browser calls the API on a different origin; an arbitrary origin is never
# reflected back with credentials.
# WEB_ORIGIN=https://app.example.com

# --- Email (optional) ---
# The API sends invitation emails. With no SMTP configured it uses a console
# transport that just logs the message (the invite link is still returned in the
# API/UI), so email is entirely optional. To deliver real email, set either
# SMTP_URL or the discrete SMTP_* vars, plus MAIL_FROM.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0            # 1 for implicit TLS (port 465); STARTTLS is used otherwise
# SMTP_USER=apikey
# SMTP_PASSWORD=
# MAIL_FROM=Agent Control Plane <no-reply@example.com>
#
# Base URL the invite "accept" links point at. Defaults to the first WEB_ORIGIN,
# else http://localhost:3000. Set it to your web app's public URL in production.
# APP_BASE_URL=https://app.example.com

# --- AI providers (BYOK) ---
# Provider API keys are NOT set here. They are added per-workspace through the UI
# (Settings -> AI Providers), encrypted at rest (AES-256-GCM), and decrypted only
# at execution time. There are intentionally no ANTHROPIC_API_KEY / OPENAI_API_KEY
# env vars — the server never reads keys from the environment.
#
# Set AI_MOCK=1 to use a built-in mock AI provider (no real API calls, no key) —
# handy for local development and demos. Leave 0/unset to call real providers
# with the keys configured in the UI.
AI_MOCK=0

# --- GitHub integration ---
# GitHub is connected per-workspace through the UI (Settings -> GitHub) with a
# Personal Access Token that is encrypted at rest — there is no token to set
# here. Set GITHUB_MOCK=1 to use a built-in mock GitHub client (no network, no
# real token) so the full code loop (connect -> branch -> commit -> pull
# request) can be exercised locally. Leave 0/unset to open real pull requests.
GITHUB_MOCK=0

# --- Webhooks ---
# Outbound webhooks are blocked from targeting private / loopback / link-local /
# cloud-metadata addresses (SSRF protection). Set WEBHOOK_ALLOW_PRIVATE=1 ONLY
# for local development, where you may want to deliver to 127.0.0.1. Leave it
# unset (or 0) in production.
WEBHOOK_ALLOW_PRIVATE=0
