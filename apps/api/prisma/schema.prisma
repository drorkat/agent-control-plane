// Agent Control Plane — initial data model.
// Tenant-aware columns (organizationId) are present from day one, but the MVP
// runs single-tenant. RLS / per-tenant isolation machinery comes later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  projects  Project[]
  agents    Agent[]
  tasks     Task[]
  runs      Run[]
  approvals Approval[]
  auditLogs AuditLog[]
  providerCredentials ProviderCredential[]
  githubConnections   GitHubConnection[]
  webhooks            Webhook[]
  notifications       Notification[]
  invitations         Invitation[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String?
  passwordHash   String
  role           String   @default("member") // owner | admin | member | viewer
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  repoUrl        String?
  repoOwner      String? // GitHub owner/org, e.g. "acme" — the code loop targets owner/name
  repoName       String? // GitHub repo name, e.g. "web"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       Agent[]
  tasks        Task[]

  @@index([organizationId])
}

model Agent {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  role           String?
  instructions   String?  @db.Text
  provider       String // anthropic | openai | ...
  model          String
  autonomyLevel  Int      @default(1)
  status         String   @default("idle") // idle | working | paused
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks        Task[]
  runs         Run[]

  @@index([organizationId])
  @@index([projectId])
}

model Task {
  id              String   @id @default(uuid())
  organizationId  String
  projectId       String
  assignedAgentId String?
  title           String
  description     String?  @db.Text
  status          String   @default("backlog") // backlog | ready | in_progress | waiting_approval | completed | failed
  priority        String   @default("medium") // low | medium | high
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgent Agent?       @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  runs          Run[]

  @@index([organizationId])
  @@index([projectId])
}

model Run {
  id             String    @id @default(uuid())
  organizationId String
  taskId         String?
  agentId        String
  provider       String
  model          String
  status         String    @default("created") // created | running | waiting_approval | completed | failed | cancelled
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Decimal   @default(0) @db.Decimal(12, 6)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events       RunEvent[]

  @@index([organizationId])
  @@index([agentId])
}

model RunEvent {
  id        String   @id @default(uuid())
  runId     String
  type      String // RUN_CREATED | MODEL_RESPONSE | TOOL_REQUESTED | APPROVAL_REQUESTED | ...
  payload   Json?
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Approval {
  id               String    @id @default(uuid())
  organizationId   String
  runId            String?
  actionType       String // merge_pr | deploy_production | ...
  resourceType     String?
  resourceId       String?
  riskLevel        String    @default("medium") // low | medium | high | critical
  status           String    @default("pending") // pending | approved | rejected
  requestedAt      DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  reason           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorType      String // user | agent | system
  actorId        String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

// A provider API key (BYOK), managed through the UI and encrypted at rest
// (AES-256-GCM). The plaintext key is never stored or returned by the API.
model ProviderCredential {
  id             String   @id @default(uuid())
  organizationId String
  provider       String // anthropic | openai | ...
  label          String?
  ciphertext     String
  iv             String
  authTag        String
  last4          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// An outbound webhook endpoint. When a subscribed event fires, the platform
// POSTs a signed JSON payload (HMAC-SHA256 over the body, using `secret`) to
// `url`. The secret is shown to the operator once at creation so they can verify
// signatures on their side; the server keeps it to sign deliveries.
model Webhook {
  id              String    @id @default(uuid())
  organizationId  String
  url             String
  secret          String
  events          String[] // e.g. ["approval.requested","run.completed","pull_request.opened"]
  active          Boolean   @default(true)
  lastStatus      String? // success | failed — the outcome of the most recent delivery
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

// One delivery attempt of a webhook, kept as a short audit trail for the UI.
model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  event      String
  status     String // success | failed
  statusCode Int?
  error      String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

// A pending invitation to join an organization. The invitee opens the link
// carrying `token`, sets their own password, and a User is created with `role`.
// The token is single-use (acceptedAt is set) and time-limited (expiresAt).
model Invitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  role            String    @default("member") // admin | member | viewer
  token           String    @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
}

// An in-app notification shown in the topbar bell. `userId` null means the
// notification is for the whole organization.
model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String? // null = org-wide
  type           String // approval.requested | run.completed | run.failed | pull_request.opened
  title          String
  body           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([read])
}

// A GitHub connection (BYOK personal access token), managed through the UI and
// encrypted at rest (AES-256-GCM). The plaintext token is never stored or
// returned by the API. The agent code loop (branch -> commit -> pull request)
// authenticates with the decrypted token only at execution time.
model GitHubConnection {
  id             String   @id @default(uuid())
  organizationId String
  accountLogin   String? // the GitHub login the token authenticated as (from /user)
  scopes         String? // reported token scopes, if any (informational)
  ciphertext     String
  iv             String
  authTag        String
  last4          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
